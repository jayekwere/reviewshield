{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[\\w.-]+\\/[\\w.-]+$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "scanner_exit": {
      "type": "number",
      "const": 0
    },
    "files": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "changed_lines": {
            "maxItems": 20000,
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "required": [
          "path",
          "source_sha256",
          "changed_lines"
        ],
        "additionalProperties": false
      }
    },
    "sarif": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "2.1.0"
        },
        "runs": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "object",
                "properties": {
                  "driver": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "enum": [
                          "Semgrep",
                          "Semgrep OSS",
                          "semgrep",
                          "CodeQL"
                        ]
                      },
                      "version": {
                        "type": "string"
                      },
                      "semanticVersion": {
                        "type": "string"
                      },
                      "rules": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "defaultConfiguration": {
                              "type": "object",
                              "properties": {
                                "level": {
                                  "type": "string",
                                  "enum": [
                                    "error",
                                    "warning",
                                    "note",
                                    "none"
                                  ]
                                }
                              },
                              "required": [
                                "level"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "id"
                          ],
                          "additionalProperties": {}
                        }
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "driver"
                ],
                "additionalProperties": {}
              },
              "invocations": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "executionSuccessful": {
                      "type": "boolean",
                      "const": true
                    },
                    "toolExecutionNotifications": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "level": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": {}
                      }
                    }
                  },
                  "required": [
                    "executionSuccessful"
                  ],
                  "additionalProperties": {}
                }
              },
              "results": {
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ruleId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "level": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning",
                        "note",
                        "none"
                      ]
                    },
                    "message": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string",
                          "maxLength": 10000
                        }
                      },
                      "required": [
                        "text"
                      ],
                      "additionalProperties": {}
                    },
                    "locations": {
                      "minItems": 1,
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "physicalLocation": {
                            "type": "object",
                            "properties": {
                              "artifactLocation": {
                                "type": "object",
                                "properties": {
                                  "uri": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 512
                                  },
                                  "uriBaseId": {
                                    "type": "string",
                                    "const": "%SRCROOT%"
                                  }
                                },
                                "required": [
                                  "uri"
                                ],
                                "additionalProperties": {}
                              },
                              "region": {
                                "type": "object",
                                "properties": {
                                  "startLine": {
                                    "type": "integer",
                                    "exclusiveMinimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "endLine": {
                                    "type": "integer",
                                    "exclusiveMinimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "startColumn": {
                                    "type": "integer",
                                    "exclusiveMinimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "endColumn": {
                                    "type": "integer",
                                    "exclusiveMinimum": 0,
                                    "maximum": 9007199254740991
                                  }
                                },
                                "required": [
                                  "startLine"
                                ],
                                "additionalProperties": {}
                              }
                            },
                            "required": [
                              "artifactLocation",
                              "region"
                            ],
                            "additionalProperties": {}
                          }
                        },
                        "required": [
                          "physicalLocation"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "partialFingerprints": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "ruleId",
                    "message",
                    "locations"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "tool",
              "invocations",
              "results"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "version",
        "runs"
      ],
      "additionalProperties": {}
    },
    "baseline": {
      "default": [],
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "level": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "note",
              "none"
            ]
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expires": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "reason": {
            "type": "string",
            "minLength": 12,
            "maxLength": 500
          }
        },
        "required": [
          "tenant",
          "repository",
          "fingerprint",
          "level",
          "source_sha256",
          "expires",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "tenant",
    "repository",
    "head_sha",
    "base_sha",
    "scanner_exit",
    "files",
    "sarif",
    "baseline"
  ],
  "additionalProperties": false
}
